# ==============================================================================
# YouTube Shorts Automation Engine - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Configuration
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
in progress dev/.env
in progress dev/.env.*
*.pem
*.key
*.cert
*.crt
*.enc
client_secret*.json
credentials.json
token.json
oauth_credentials.json
cookies.txt
cookies*.txt
harvester_cookies*.txt
storage/harvester_cookies.txt
storage/cookies.txt
*.bak

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Python Runtime
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
Lib/
Scripts/
!/scripts/
pyvenv.cfg

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging & Distribution
build/
develop-eggs/
dist/
/downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. Local Databases, State & Dynamic Runtime Configurations
# ------------------------------------------------------------------------------
storage/*.db
storage/*.db-shm
storage/*.db-wal
storage/*.sqlite
storage/*.sqlite3
storage/*.json
storage/*.lock
*.lock
storage/api_key_usage.json
storage/quota_state.json
storage/deep_audit_dump.json
storage/detailed_failure_audit.json
storage/config/runtime_settings.json

# ------------------------------------------------------------------------------
# 4. Storage Directories (Preserve directory structure with .gitkeep)
# ------------------------------------------------------------------------------
storage/downloads/**
!storage/downloads/.gitkeep

storage/outputs/**
!storage/outputs/.gitkeep

storage/temp/**
!storage/temp/.gitkeep

storage/thumbnails/**
!storage/thumbnails/.gitkeep

storage/models/**
!storage/models/.gitkeep

storage/logs/**
!storage/logs/.gitkeep

storage/config/**
!storage/config/.gitkeep

storage/backups/**
!storage/backups/.gitkeep

storage/crops/**
!storage/crops/.gitkeep

# Root/Global logs
*.log
/logs/

# ------------------------------------------------------------------------------
# 5. Heavy Media, Video & Audio Files (Never commit raw video clips)
# ------------------------------------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.flv
*.m4v
*.wav
*.mp3
*.aac
*.m4a
*.ogg
*.flac

# Preserve bundled assets and sound effects library
!assets/sfx_library/*
!assets/sfx_library/.gitkeep

# ------------------------------------------------------------------------------
# 6. Archive Bundles & Internal Office Documents
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.docx
*.pptx
*.xlsx
find channel id.txt
folder_structure.txt
import_analysis.json
scratch/

# ------------------------------------------------------------------------------
# 7. IDE, Editor & OS Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 8. Testing, Linting & Coverage Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/
test_run_output.txt
scratch_queue.html